{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "stayguide-prototype",
  "main": "./src/worker.js",
  "compatibility_date": "2026-11-10",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/g/*"]
  },
  "d1_databases": [
    {"binding": "DB", "database_name": "stayguide", "database_id": "REPLACE_WITH_D1_DATABASE_ID"}
  ]
}
