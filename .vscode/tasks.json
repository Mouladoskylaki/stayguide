{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "StayGuide: Start full local app",
      "type": "npm",
      "script": "start",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "StayGuide: Run tests",
      "type": "npm",
      "script": "test",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
